@model ZonaDeImpacto.Models.Usuario
@{
    ViewData["Title"] = "Detalles del Usuario";
}

<div class="card shadow-sm" style="max-width: 700px; margin: 0 auto;">
    <div class="card-header text-white" style="background-color: #17a2b8;">
        <h5 class="mb-0">
            <i class="fas fa-eye me-2"></i>@ViewData["Title"]
        </h5>
    </div>

    <div class="card-body">
        <!-- PRESENTACIÓN DEL USUARIO -->
        <div class="text-center mb-4">
            @if (Model.rol == "Admin" || Model.rol == "Administrador")
            {
                <div class="mb-3">
                    <i class="fas fa-crown fa-4x" style="color: #5656a6;"></i>
                </div>
                <h4 class="text-primary">@Model.nombreCompleto</h4>
                <span class="badge-admin fs-6">
                    <i class="fas fa-user-shield me-1"></i> ADMINISTRADOR
                </span>
            }
            else
            {
                <div class="mb-3">
                    <i class="fas fa-tools fa-4x" style="color: #2ba1a1;"></i>
                </div>
                <h4 class="text-primary">@Model.nombreCompleto</h4>
                <span class="badge-trabajador fs-6">
                    <i class="fas fa-user-hard-hat me-1"></i> TRABAJADOR
                </span>
            }
        </div>

        <!-- RESUMEN DEL PERFIL -->
        <div class="row">
            <!-- Nombre Completo -->
            <div class="col-md-6">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
                        <i class="fas fa-user fa-lg text-primary"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Nombre Completo</small>
                        <strong>@Model.nombreCompleto</strong>
                    </div>
                </div>
            </div>

            <!-- Usuario de Acceso -->
            <div class="col-md-6">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-info bg-opacity-10 p-2 rounded me-3">
                        <i class="fas fa-sign-in-alt fa-lg text-info"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Usuario de Acceso</small>
                        <strong>@Model.usuario</strong>
                    </div>
                </div>
            </div>

            <!-- Tipo de Usuario (CON ICONOS DISTINTIVOS) -->
            <div class="col-md-6">
                <div class="d-flex align-items-center mb-3">
                    @if (Model.rol == "Admin" || Model.rol == "Administrador")
                    {
                        <!-- Para Administrador -->
                        <div class="bg-purple p-2 rounded me-3">
                            <i class="fas fa-crown fa-lg text-white"></i> 
                        </div>
                        <div>
                            <small class="text-muted d-block">Tipo de Usuario</small>
                            <strong>@Model.rol</strong>
                        </div>
                    }
                    else
                    {
                        <!-- Para Trabajador -->
                        <div class="bg-teal p-2 rounded me-3">
                            <i class="fas fa-tools fa-lg text-white"></i> 
                        </div>
                        <div>
                            <small class="text-muted d-block">Tipo de Usuario</small>
                            <strong>@Model.rol</strong>
                        </div>
                    }
                </div>
            </div>

            <!-- Estado Actual -->
            <div class="col-md-6">
                <div class="d-flex align-items-center mb-3">
                    <div class="@(Model.estado ? "bg-success bg-opacity-10" : "bg-danger bg-opacity-10") p-2 rounded me-3">
                        <i class="fas @(Model.estado ? "fa-check-circle fa-lg text-success" : "fa-times-circle fa-lg text-danger")"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block">Estado Actual</small>
                        <strong>@(Model.estado ? "Activo" : "Inactivo")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTONES DE ACCIÓN -->
        <div class="mt-4 pt-3 border-top">
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Editar" asp-route-id="@Model.idUsuario"
                   class="btn btn-warning px-4">
                    <i class="fas fa-edit me-1"></i> Editar Usuario
                </a>

                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="fas fa-arrow-left me-1"></i> Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .badge-admin {
        background-color: #5656a6;
        color: white;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: bold;
        display: inline-block;
    }

    .badge-trabajador {
        background-color: #2ba1a1;
        color: white;
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: bold;
        display: inline-block;
    }

    .bg-purple {
        background-color: #5656a6 !important;
    }

    .text-purple {
        color: #5656a6 !important;
    }

    .bg-teal {
        background-color: #2ba1a1 !important;
    }

    .text-teal {
        color: #2ba1a1 !important;
    }

    .fa-4x {
        font-size: 4rem;
    }
</style>