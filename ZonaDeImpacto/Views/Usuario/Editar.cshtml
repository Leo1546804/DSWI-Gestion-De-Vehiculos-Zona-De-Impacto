@model ZonaDeImpacto.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="card shadow-sm" style="max-width: 700px; margin: 0 auto;">
    <div class="card-header text-white" style="background-color: #d4a017;">
        <h5 class="mb-0">
            <i class="fas fa-edit me-2"></i>@ViewData["Title"]
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="idUsuario" />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="nombreCompleto" class="form-label"></label>
                        <input asp-for="nombreCompleto" class="form-control" />
                        <span asp-validation-for="nombreCompleto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="usuario" class="form-label"></label>
                        <input asp-for="usuario" class="form-control" />
                        <span asp-validation-for="usuario" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <!-- type="text" para que se cargue el valor -->
                    <div class="mb-3">
                        <label asp-for="password" class="form-label">Contraseña</label>
                        <input asp-for="password" type="text" class="form-control"
                               placeholder="Dejar en blanco para mantener la contraseña actual" />
                        <div class="form-text">Dejar en blanco para mantener la contraseña actual</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="rol" class="form-label"></label>
                        <select asp-for="rol" class="form-control">
                            <option value="">Seleccione un rol</option>
                            <option value="Administrador">Administrador</option>
                            <option value="Trabajador">Trabajador</option>
                        </select>
                        <span asp-validation-for="rol" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="estado" class="form-label"></label>
                        <select asp-for="estado" class="form-control">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                        <span asp-validation-for="estado" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-warning px-4" style="background-color: #d4a017; border-color: #d4a017;">
                        <i class="fas fa-save me-1"></i> Actualizar Usuario
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Volver al Listado
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}