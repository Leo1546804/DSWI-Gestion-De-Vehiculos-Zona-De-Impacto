@model IEnumerable<ZonaDeImpacto.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <!-- ENCABEZADO -->
    <div class="card-header text-white" style="background-color: #1a237e;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">
                    <i class="fas fa-users me-2"></i>@ViewData["Title"]
                </h5>
            </div>
            <div>
                <a asp-action="Crear" class="btn btn-success px-4">
                    <i class="fas fa-user-plus me-1"></i> Nuevo Usuario
                </a>
            </div>
        </div>
    </div>

    <!-- SECCIÓN DE FILTROS - DISTRIBUCIÓN COMO VEHÍCULOS -->
    <div class="card-body border-bottom py-3">
        <form method="get" class="row align-items-end">
            <!-- FILTRO 1: Buscar Usuario (col-md-2 col-lg-2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Buscar usuario:</label>
                <input type="text" name="filtroNombre" class="form-control form-control-sm"
                       placeholder="Ej: sergio" value="@ViewBag.FiltroNombre" />
            </div>

            <!-- FILTRO 2: Rol (col-md-2 col-lg-2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Rol:</label>
                <select name="filtroRol" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var rol in ViewBag.Roles)
                    {
                        <option value="@rol" selected="@(ViewBag.FiltroRol == rol)">
                            @rol
                        </option>
                    }
                </select>
            </div>

            <!-- FILTRO 3: Estado (col-md-2 col-lg-2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Estado:</label>
                <select name="filtroEstado" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="activos" selected="@(ViewBag.FiltroEstado == "activos")">
                        Activos
                    </option>
                    <option value="inactivos" selected="@(ViewBag.FiltroEstado == "inactivos")">
                        Inactivos
                    </option>
                </select>
            </div>

            <!-- FILTRO 4: VACÍO (col-md-2 col-lg-2 - posición de Estado Vehículo) -->
            <div class="col-md-2 col-lg-2">
                <!-- Espacio para mantener distribución -->
            </div>

            <!-- FILTRO 5: VACÍO (col-md-1 col-lg-1 - posición de Año) -->
            <div class="col-md-1 col-lg-1">
                <!-- Espacio pequeño para mantener distribución -->
            </div>

            <!-- BOTÓN LIMPIAR (col-md-1 col-lg-1 - IGUAL QUE VEHÍCULOS) -->
            <div class="col-md-1 col-lg-1">
                @if (!string.IsNullOrEmpty(ViewBag.FiltroNombre) ||
                                !string.IsNullOrEmpty(ViewBag.FiltroRol) ||
                                !string.IsNullOrEmpty(ViewBag.FiltroEstado))
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm w-100 py-1">
                        <i class="fas fa-times me-1"></i> Limpiar
                    </a>
                }
                else
                {
                    <div class="w-100" style="height: 33px;"></div>
                }
            </div>

            <!-- BOTÓN FILTRAR (col-md-1 col-lg-1 - IGUAL QUE VEHÍCULOS) -->
            <div class="col-md-1 col-lg-1">
                <button type="submit" class="btn btn-sm w-100 py-1"
                        style="background-color: #283593; border-color: #283593; color: white;">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>
            </div>
        </form>
    </div>

    <!-- TABLA DE USUARIOS -->
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.nombreCompleto</td>
                            <td>@usuario.usuario</td>
                            <td>
                                @if (usuario.rol == "Admin" || usuario.rol == "Administrador")
                                {
                                    <span class="badge-admin">Administrador</span>
                                }
                                else
                                {
                                    <span class="badge-trabajador">Trabajador</span>
                                }
                            </td>
                            <td>
                                @if (usuario.estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- Botón Detalles -->
                                    <a asp-action="Detalles"
                                       asp-route-id="@usuario.idUsuario"
                                       asp-route-filtroEstado="@ViewBag.FiltroEstado"
                                       class="btn btn-info btn-sm" style="min-width: 90px;">
                                        <i class="fas fa-eye me-1"></i> Detalles
                                    </a>

                                    <!-- Botón Editar -->
                                    <a asp-action="Editar"
                                       asp-route-id="@usuario.idUsuario"
                                       asp-route-filtroEstado="@ViewBag.FiltroEstado"
                                       class="btn btn-warning btn-sm" style="min-width: 90px;">
                                        <i class="fas fa-edit me-1"></i> Editar
                                    </a>

                                    <!-- Botón Deshabilitar/Habilitar -->
                                    @if (usuario.estado)
                                    {
                                        <a asp-action="Eliminar"
                                           asp-route-id="@usuario.idUsuario"
                                           asp-route-filtroEstado="@ViewBag.FiltroEstado"
                                           class="btn btn-danger btn-sm" style="min-width: 110px;"
                                           onclick="return confirm('¿Estás seguro de deshabilitar al usuario @usuario.usuario?\\n\\nEl usuario NO podrá iniciar sesión pero permanecerá en el sistema.');">
                                            <i class="fas fa-user-slash me-1"></i> Deshabilitar
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Habilitar"
                                           asp-route-id="@usuario.idUsuario"
                                           asp-route-filtroEstado="@ViewBag.FiltroEstado"
                                           class="btn btn-success btn-sm" style="min-width: 110px;"
                                           onclick="return confirm('¿Estás seguro de habilitar al usuario @usuario.usuario?\\n\\nEl usuario podrá iniciar sesión nuevamente.');">
                                            <i class="fas fa-user-check me-1"></i> Habilitar
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <i class="fas fa-info-circle fa-lg text-muted mb-2"></i>
                                <p class="text-muted mb-0">
                                    @if (!string.IsNullOrEmpty(ViewBag.FiltroNombre) ||
                                                                    !string.IsNullOrEmpty(ViewBag.FiltroRol) ||
                                                                    !string.IsNullOrEmpty(ViewBag.FiltroEstado))
                                    {
                                        <span>No hay usuarios que coincidan con los filtros aplicados</span>
                                    }
                                    else
                                    {
                                        <span>No hay usuarios registrados</span>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(ViewBag.FiltroNombre) ||
                                                            !string.IsNullOrEmpty(ViewBag.FiltroRol) ||
                                                            !string.IsNullOrEmpty(ViewBag.FiltroEstado))
                                {
                                    <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-sm mt-2">
                                        <i class="fas fa-times me-1"></i> Limpiar filtros
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Crear" class="btn btn-success btn-sm mt-2">
                                        <i class="fas fa-plus me-1"></i> Agregar Primer Usuario
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .badge-admin {
        background-color: #5656a6;
        color: white;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: bold;
    }

    .badge-trabajador {
        background-color: #2ba1a1;
        color: white;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: bold;
    }

    .table th {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 8px;
        background-color: #1a237e;
        color: white;
    }

    .table td {
        font-size: 14px;
        padding: 12px 8px;
        vertical-align: middle;
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 13px;
    }

    .d-flex.gap-2 {
        gap: 10px;
    }

    .card {
        border-radius: 8px;
    }

    .form-label {
        font-weight: 500;
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
        color: #495057;
    }

    .form-control-sm, .form-select-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        height: calc(1.5em + 0.5rem + 2px);
    }

    .border-bottom {
        border-bottom: 1px solid rgba(0,0,0,.125);
    }

    /* ESTA REGLA ES LA CLAVE PARA BOTONES IGUALES A VEHÍCULOS */
    .col-md-1.col-lg-1 .btn-sm {
        min-height: 33px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>