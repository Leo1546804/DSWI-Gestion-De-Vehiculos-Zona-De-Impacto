@model ZonaDeImpacto.Models.Usuario
@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="card shadow-sm" style="max-width: 700px; margin: 0 auto;">
    <div class="card-header text-white" style="background-color: #1a237e;">
        <h5 class="mb-0">
            <i class="fas fa-user-plus me-2"></i>@ViewData["Title"]
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Crear" method="post">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="nombreCompleto" class="form-label"></label>
                        <input asp-for="nombreCompleto" class="form-control" />
                        <span asp-validation-for="nombreCompleto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="usuario" class="form-label"></label>
                        <input asp-for="usuario" class="form-control" />
                        <span asp-validation-for="usuario" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="password" class="form-label"></label>
                        <input asp-for="password" type="password" class="form-control" />
                        <span asp-validation-for="password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="rol" class="form-label"></label>
                        <select asp-for="rol" class="form-control">
                            <option value="">Seleccione un rol</option>
                            <option value="Admin">Administrador</option>
                            <option value="Trabajador">Trabajador</option>
                        </select>
                        <span asp-validation-for="rol" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn text-white px-4"
                            style="background-color: #1a237e; border-color: #1a237e;">
                        <i class="fas fa-save me-1"></i> Guardar Usuario
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Volver al Listado
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}