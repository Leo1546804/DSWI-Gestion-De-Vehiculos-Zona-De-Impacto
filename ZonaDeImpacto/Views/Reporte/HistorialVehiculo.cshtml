@model ZonaDeImpacto.Models.Reportes.ReporteHistorialVehiculo
@{
    ViewData["Title"] = "Historial de Vehículo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header text-white" style="background-color: #1a237e;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fas fa-history fa-2x me-3"></i>
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <small class="opacity-75">
                        Reporte detallado de mantenimientos y gastos por vehículo
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- FORMULARIO DE SELECCIÓN -->
    @if (Model?.placa == null)
    {
        <div class="card-body">
            <form method="post" action="@Url.Action("HistorialVehiculoPost")" class="row align-items-end">
                <div class="col-md-8">
                    <label class="form-label mb-1">Seleccionar Vehículo:</label>
                    <select name="idVehiculo" class="form-select" required>
                        <option value="">-- Seleccione un vehículo --</option>
                        @if (ViewBag.Vehiculos != null)
                        {
                            foreach (var vehiculo in ViewBag.Vehiculos)
                            {
                                <option value="@vehiculo.idVehiculo">
                                    @vehiculo.placa - @vehiculo.marca @vehiculo.modelo
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm w-100 py-2"
                            style="background-color: #283593; border-color: #283593; color: white;">
                        <i class="fas fa-search me-1"></i> Generar Reporte
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="@Url.Action("Index", "Reporte")" class="btn btn-outline-secondary btn-sm w-100 py-2">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </form>
        </div>
    }
    else
    {
        <!-- INFORMACIÓN DEL VEHÍCULO -->
        <div class="card-body border-bottom">
            <div class="row">
                <div class="col-md-8">
                    <h4>@Model.marca @Model.modelo</h4>
                    <div class="row mt-2">
                        <div class="col-md-3">
                            <p class="mb-1"><strong>Placa:</strong></p>
                            <span>@Model.placa</span>
                        </div>
                        <div class="col-md-3">
                            <p class="mb-1"><strong>Tipo:</strong></p>
                            <span>@Model.tipo</span>
                        </div>
                        <div class="col-md-3">
                            <p class="mb-1"><strong>Año:</strong></p>
                            <span>@(Model.anio?.ToString() ?? "N/A")</span>
                        </div>
                        <div class="col-md-3">
                            <p class="mb-1"><strong>Estado:</strong></p>
                            <span>@(Model.estado ?? "N/A")</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <div class="card bg-light">
                        <div class="card-body py-2">
                            <div class="row text-center">
                                <div class="col-6">
                                    <p class="mb-0 text-muted">Mantenimientos</p>
                                    <h4>@Model.Mantenimientos.Count</h4>
                                </div>
                                <div class="col-6">
                                    <p class="mb-0 text-muted">Total Gastado</p>
                                    <h4 class="text-danger">
                                        S/ @Model.Mantenimientos.Sum(m => m.totalMantenimiento).ToString("N2")
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MANTENIMIENTOS -->
        <div class="card-body">
            <h6 class="mb-3">
                <i class="fas fa-tools me-2"></i>Historial de Mantenimientos
                <span class="badge bg-primary ms-2">@Model.Mantenimientos.Count</span>
            </h6>

            @if (Model.Mantenimientos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Responsable</th>
                                <th>Descripción</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mantenimiento in Model.Mantenimientos)
                            {
                                <tr>
                                    <td>
                                        <strong>@mantenimiento.codigoMantenimiento</strong>
                                    </td>
                                    <td>@mantenimiento.fechaMantenimiento.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @mantenimiento.tipoMantenimiento
                                    </td>
                                    <td>@mantenimiento.responsable</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(mantenimiento.descripcionMantenimiento))
                                        {
                                            <span class="text-muted">@mantenimiento.descripcionMantenimiento</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin descripción</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-danger">
                                        S/ @mantenimiento.totalMantenimiento.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #e3f2fd;">
                                <td colspan="5" class="text-end fw-bold">TOTAL GENERAL:</td>
                                <td class="text-end fw-bold text-danger">
                                    S/ @Model.Mantenimientos.Sum(m => m.totalMantenimiento).ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-clipboard-list fa-2x text-muted mb-2"></i>
                    <p class="text-muted mb-0">Este vehículo no tiene mantenimientos registrados</p>
                </div>
            }
        </div>

        <!-- PIE DE PÁGINA -->
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a href="@Url.Action("HistorialVehiculo")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Seleccionar Otro
                </a>
                <div>
                    <a href="@Url.Action("CostosPorVehiculo")" class="btn btn-primary">
                        <i class="fas fa-chart-pie me-1"></i> Ver Todos los Costos
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .table th {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 8px;
        background-color: #1a237e;
        color: white;
    }

    .table td {
        font-size: 14px;
        padding: 12px 8px;
        vertical-align: middle;
    }

    .badge {
        font-size: 12px;
        padding: 4px 8px;
    }

    .form-label {
        font-weight: 500;
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
        color: #495057;
    }
</style>