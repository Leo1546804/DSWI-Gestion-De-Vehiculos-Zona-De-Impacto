@model IEnumerable<ZonaDeImpacto.Models.TipoGasto>

@{
    ViewData["Title"] = "Tipos de Gasto";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header text-white" style="background-color: #1a237e;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fas fa-list-alt fa-2x me-3"></i>
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <small class="opacity-75">Gestión de tipos de gasto vehicular</small>
                </div>
            </div>
            <div>
                <a asp-action="Crear" class="btn btn-success px-4">
                    <i class="fas fa-plus me-1"></i> Nuevo Tipo de Gasto
                </a>
            </div>
        </div>
    </div>

    <!-- SECCIÓN DE FILTROS - DISTRIBUCIÓN IDÉNTICA A VEHÍCULOS -->
    <div class="card-body border-bottom py-3">
        <form method="get" class="row align-items-end">
            <!-- Campo oculto para mantener la página actual -->
            <input type="hidden" name="pagina" value="@ViewBag.PaginaActual" />

            <!-- FILTRO 1: Nombre (2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Nombre:</label>
                <input type="text" name="filtroNombre" class="form-control form-control-sm"
                       placeholder="Ej: Combustible" value="@ViewBag.FiltroNombre" />
            </div>

            <!-- FILTRO 2: Estado (2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Estado:</label>
                <select name="filtroEstado" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    <option value="activos" selected="@(ViewBag.FiltroEstado == "activos")">Activos</option>
                    <option value="inactivos" selected="@(ViewBag.FiltroEstado == "inactivos")">Inactivos</option>
                </select>
            </div>

            <!-- FILTRO 3: VACÍO (2) -->
            <div class="col-md-2 col-lg-2">
                <!-- Espacio reservado para mantener distribución -->
            </div>

            <!-- FILTRO 4: VACÍO (1) -->
            <div class="col-md-1 col-lg-1">
                <!-- Espacio reservado para mantener distribución -->
            </div>

            <!-- FILTRO 5: VACÍO (1) -->
            <div class="col-md-1 col-lg-1">
                <!-- Espacio reservado para mantener distribución -->
            </div>

            <!-- FILTRO 6: VACÍO (1) -->
            <div class="col-md-1 col-lg-1">
                <!-- Espacio reservado para mantener distribución -->
            </div>

            <!-- BOTÓN LIMPIAR (1) -->
            <div class="col-md-1 col-lg-1">
                @if (!string.IsNullOrEmpty(ViewBag.FiltroNombre) ||
                                !string.IsNullOrEmpty(ViewBag.FiltroEstado) ||
                                (ViewBag.PaginaActual > 1))
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm w-100 py-1">
                        <i class="fas fa-times me-1"></i> Limpiar
                    </a>
                }
                else
                {
                    <div class="w-100" style="height: 33px;"></div>
                }
            </div>

            <!-- BOTÓN FILTRAR (1) -->
            <div class="col-md-1 col-lg-1">
                <button type="submit" class="btn btn-sm w-100 py-1"
                        style="background-color: #283593; border-color: #283593; color: white;">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        // Primero los activos, luego los inactivos
                        var tiposOrdenados = Model
                        .OrderByDescending(t => t.estadoLogico)  // Activos primero
                        .ThenBy(t => t.nombre);                  // Luego orden alfabético

                        @foreach (var tipo in tiposOrdenados)
                        {
                            <tr>
                                <td><strong>@tipo.nombre</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(tipo.descripcion))
                                    {
                                        <span class="text-muted">
                                            @(tipo.descripcion.Length > 50 ? tipo.descripcion.Substring(0, 50) + "..." : tipo.descripcion)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Sin descripción</span>
                                    }
                                </td>
                                <td>
                                    @if (tipo.estadoLogico)
                                    {
                                        <span class="badge bg-primary">
                                            <i class="fas fa-check me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-times me-1"></i> Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Botón Detalles -->
                                        <a asp-action="Detalles" asp-route-id="@tipo.idTipoGasto"
                                           class="btn btn-info btn-sm" style="min-width: 90px;">
                                            <i class="fas fa-eye me-1"></i> Detalles
                                        </a>

                                        <!-- Botón Editar -->
                                        <a asp-action="Editar" asp-route-id="@tipo.idTipoGasto"
                                           class="btn btn-warning btn-sm" style="min-width: 80px;">
                                            <i class="fas fa-edit me-1"></i> Editar
                                        </a>

                                        <!-- Botón Deshabilitar/Habilitar -->
                                        @if (tipo.estadoLogico)
                                        {
                                            <form asp-action="Eliminar" method="post" style="display: inline;">
                                                <input type="hidden" name="id" value="@tipo.idTipoGasto" />
                                                <button type="submit" class="btn btn-danger btn-sm"
                                                        style="min-width: 110px;"
                                                        onclick="return confirm('¿Estás seguro de desactivar el tipo de gasto @tipo.nombre?');">
                                                    <i class="fas fa-user-slash me-1"></i> Desactivar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Habilitar" method="post" style="display: inline;">
                                                <input type="hidden" name="id" value="@tipo.idTipoGasto" />
                                                <button type="submit" class="btn btn-success btn-sm"
                                                        style="min-width: 110px;"
                                                        onclick="return confirm('¿Estás seguro de habilitar el tipo de gasto @tipo.nombre?');">
                                                    <i class="fas fa-user-check me-1"></i> Habilitar
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <i class="fas fa-list-alt fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">
                                    @if (!string.IsNullOrEmpty(ViewBag.FiltroNombre) ||
                                                                    !string.IsNullOrEmpty(ViewBag.FiltroEstado))
                                    {
                                        <span>No hay tipos de gasto que coincidan con los filtros aplicados</span>
                                    }
                                    else
                                    {
                                        <span>No hay tipos de gasto registrados</span>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(ViewBag.FiltroNombre) ||
                                                            !string.IsNullOrEmpty(ViewBag.FiltroEstado))
                                {
                                    <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-sm mt-2">
                                        <i class="fas fa-times me-1"></i> Limpiar filtros
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Crear" class="btn btn-success btn-sm mt-2">
                                        <i class="fas fa-plus me-1"></i> Agregar Primer Tipo
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (ViewBag.TotalPaginas > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                               asp-route-filtroNombre="@ViewBag.FiltroNombre"
                               asp-route-filtroEstado="@ViewBag.FiltroEstado">
                                Anterior
                            </a>
                        </li>
                        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pagina="@i"
                                   asp-route-filtroNombre="@ViewBag.FiltroNombre"
                                   asp-route-filtroEstado="@ViewBag.FiltroEstado">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                               asp-route-filtroNombre="@ViewBag.FiltroNombre"
                               asp-route-filtroEstado="@ViewBag.FiltroEstado">
                                Siguiente
                            </a>
                        </li>
                    </ul>
                </nav>
            }
            <!-- Mostrar información de paginación -->
            @if (ViewBag.TotalRegistros > 0)
            {
                <div class="text-center text-muted mt-2">
                    <small>
                        Mostrando @(((ViewBag.PaginaActual - 1) * 6 + 1)) a
                        @Math.Min(ViewBag.PaginaActual * 6, ViewBag.TotalRegistros)
                        de @ViewBag.TotalRegistros gastos
                    </small>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 8px;
        background-color: #1a237e;
        color: white;
    }

    .table td {
        font-size: 14px;
        padding: 12px 8px;
        vertical-align: middle;
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 13px;
    }

    .d-flex.gap-2 {
        gap: 10px !important;
    }

    .badge {
        font-size: 12px;
        padding: 4px 8px;
    }

    .form-label {
        font-weight: 500;
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
        color: #495057;
    }

    .form-control-sm, .form-select-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        height: calc(1.5em + 0.5rem + 2px);
    }

    .pagination {
        margin-top: 20px;
        margin-bottom: 0;
    }

    .page-link {
        color: #1a237e;
        border-color: #1a237e;
    }

    .page-item.active .page-link {
        background-color: #1a237e;
        border-color: #1a237e;
    }

    .page-link:hover {
        color: #1a237e;
        background-color: #e8eaf6;
    }

    .col-md-1.col-lg-1 .btn-sm {
        min-height: 33px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>