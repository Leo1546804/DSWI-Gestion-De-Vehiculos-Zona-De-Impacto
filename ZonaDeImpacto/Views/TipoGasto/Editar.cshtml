@model ZonaDeImpacto.Models.TipoGasto
@{
    ViewData["Title"] = "Editar Tipo de Gasto";
}

<div class="card shadow-sm" style="max-width: 700px; margin: 0 auto;">
    <div class="card-header text-white" style="background-color: #d4a017;">
        <h5 class="mb-0">
            <i class="fas fa-edit me-2"></i>@ViewData["Title"]
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="idTipoGasto" />
            <input type="hidden" name="filtroEstado" value="@ViewBag.FiltroEstado" />

            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <label asp-for="nombre" class="form-label"></label>
                        <input asp-for="nombre" class="form-control" placeholder="Ej: Combustible" />
                        <span asp-validation-for="nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="descripcion" class="form-label"></label>
                        <textarea asp-for="descripcion" class="form-control" rows="3"
                                  placeholder="Ej: Gastos relacionados con combustible de vehículos"></textarea>
                        <span asp-validation-for="descripcion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-warning px-4" style="background-color: #d4a017; border-color: #d4a017;">
                        <i class="fas fa-save me-1"></i> Actualizar
                    </button>
                    <a asp-action="Index" asp-route-filtroEstado="@ViewBag.FiltroEstado" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}