@{
    string nombre = Context.Session.GetString("nombre");
    string rol = Context.Session.GetString("rol");
    string _nameApp = "Zona de Impacto";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @_nameApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="icon" type="image/png" href="~/img/logo.jpg" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-car-crash logo-icon"></i> @_nameApp
            </a>

            @if (!string.IsNullOrEmpty(nombre))
            {
                <div class="navbar-text text-white">
                    <i class="fas fa-user me-1"></i> @nombre
                    @if (rol == "Admin")
                    {
                        <span class="badge-admin ms-2">Administrador</span>
                    }
                    else if (rol == "Trabajador")
                    {
                        <span class="badge-trabajador ms-2">Trabajador</span>
                    }
                </div>
            }
        </div>
    </nav>

    <!-- CONTENEDOR PRINCIPAL QUE EMPUJA EL FOOTER -->
    <div id="page-wrapper">
        <div class="container-fluid mt-3">
            <div class="row">
                @if (!string.IsNullOrEmpty(rol))
                {
                    <!-- Sidebar -->
                    <div class="col-lg-2 col-md-3 sidebar">
                        <div class="sticky-top pt-4">
                            <h5 class="text-primario px-3 mb-4">
                                <i class="fas fa-bars me-2"></i>Menú Principal
                            </h5>

                            <div class="mb-4">
                                <a class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-home me-2"></i> Inicio
                                </a>

                                @if (rol == "Admin")
                                {
                                    <a class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuario" ? "active" : "")"
                                       asp-controller="Usuario" asp-action="Index">
                                        <i class="fas fa-users me-2"></i> Usuarios
                                    </a>

                                    <a class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Vehiculo" ? "active" : "")"
                                       asp-controller="Vehiculo" asp-action="Index">
                                        <i class="fas fa-car me-2"></i> Vehículos
                                    </a>
                                    <!-- MANTENIMIENTOS  -->
                                    <a class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mantenimiento" ? "active" : "")"
                                       asp-controller="Mantenimiento" asp-action="Index">
                                        <i class="fas fa-tools me-2"></i> Mantenimientos
                                    </a>

                                    <!-- TIPOS DE GASTO (después de Mantenimientos) -->
                                    <a class="sidebar-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "TipoGasto" ? "active" : "")"
                                       asp-controller="TipoGasto" asp-action="Index">
                                        <i class="fas fa-tags me-2"></i> Tipos de Gasto
                                    </a>

                                    <a class="sidebar-item" href="#">
                                        <i class="fas fa-money-bill-wave me-2"></i> Gastos
                                    </a>

                                    <a class="sidebar-item" href="#">
                                        <i class="fas fa-chart-bar me-2"></i> Reportes
                                    </a>
                                }

                                @if (rol == "Trabajador")
                                {
                                    <a class="sidebar-item" href="#">
                                        <i class="fas fa-wrench me-2"></i> Registrar Mantenimiento
                                    </a>

                                    <a class="sidebar-item" href="#">
                                        <i class="fas fa-money-bill-wave me-2"></i> Registrar Gasto
                                    </a>

                                    <a class="sidebar-item" href="#">
                                        <i class="fas fa-list me-2"></i> Mis Mantenimientos
                                    </a>

                                    <a class="sidebar-item" href="#">
                                        <i class="fas fa-file-invoice-dollar me-2"></i> Mis Gastos Reportados
                                    </a>
                                }
                            </div>

                            <hr>
                            <a class="sidebar-item text-danger mt-3" asp-controller="Login" asp-action="Logout">
                                <i class="fas fa-sign-out-alt me-2"></i> Cerrar Sesión
                            </a>
                        </div>
                    </div>
                }

                <!-- Main Content -->
                <div class="@(!string.IsNullOrEmpty(rol) ? "col-lg-10 col-md-9" : "col-12")">
                    <main class="main-content">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <p class="mb-0">
                &copy; @DateTime.Now.Year - @_nameApp |
                Sistema de Gestión de Mantenimiento de Vehículos
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>