@model ZonaDeImpacto.Models.Vehiculo
@{
    ViewData["Title"] = "Registrar Vehículo";
    var tipos = ViewBag.Tipos as List<string> ?? new List<string>();
}

<div class="card shadow-sm" style="max-width: 700px; margin: 0 auto;">
    <div class="card-header text-white" style="background-color: #1a237e;">
        <h5 class="mb-0">
            <i class="fas fa-car me-2"></i>@ViewData["Title"]
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Crear" method="post">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="placa" class="form-label"></label>
                        <input asp-for="placa" class="form-control" placeholder="Ej: ABC-123" />
                        <span asp-validation-for="placa" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="marca" class="form-label"></label>
                        <input asp-for="marca" class="form-control" placeholder="Ej: Toyota" />
                        <span asp-validation-for="marca" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="modelo" class="form-label"></label>
                        <input asp-for="modelo" class="form-control" placeholder="Ej: Corolla" />
                        <span asp-validation-for="modelo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="tipo" class="form-label"></label>
                        <select asp-for="tipo" class="form-control">
                            <option value="">Seleccione un tipo</option>
                            @foreach (var tipo in tipos)
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                        <span asp-validation-for="tipo" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="anio" class="form-label"></label>
                        <input asp-for="anio" class="form-control" placeholder="Ej: 2023" />
                        <span asp-validation-for="anio" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="kilometraje" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="kilometraje" class="form-control" placeholder="Ej: 15000" />
                            <span class="input-group-text">km</span>
                        </div>
                        <span asp-validation-for="kilometraje" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="estado" class="form-label"></label>
                        <select asp-for="estado" class="form-control">
                            <option value="">Seleccione estado</option>
                            <option value="Operativo">Operativo</option>
                            <option value="En Taller">En Taller</option>
                            <option value="Inoperativo">Inoperativo</option>
                        </select>
                        <span asp-validation-for="estado" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn text-white px-4"
                            style="background-color: #1a237e; border-color: #1a237e;">
                        <i class="fas fa-save me-1"></i> Guardar Vehículo
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Volver al Listado
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}