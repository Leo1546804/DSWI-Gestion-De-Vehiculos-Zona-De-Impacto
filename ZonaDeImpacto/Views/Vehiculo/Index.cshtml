@model IEnumerable<ZonaDeImpacto.Models.Vehiculo>

@{
    ViewData["Title"] = "Lista de Vehículos";
}

<h2 class="mb-4">Lista de Vehículos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-3">
    <a href="@Url.Action("Crear", "Vehiculo")" class="btn btn-primary">Registrar Nuevo Vehículo</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Placa</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Año</th>
            <th>Kilometraje</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.idVehiculo</td>
                <td>@v.placa</td>
                <td>@v.marca</td>
                <td>@v.modelo</td>
                <td>@v.anio</td>
                <td>@v.kilometraje</td>
                <td>@v.estado</td>
                <td>
                    <a href="@Url.Action("Editar", "Vehiculo", new { id = v.idVehiculo })" class="btn btn-warning btn-sm">Editar</a>
                    <a href="@Url.Action("Eliminar", "Vehiculo", new { id = v.idVehiculo })"
                       onclick="return confirm('¿Está seguro de eliminar este vehículo?');"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
