@model IEnumerable<Vehiculo>

<h2>Lista de Vehículos</h2>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Placa</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Año</th>
            <th>Kilometraje</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.idVehiculo</td>
                <td>@v.placa</td>
                <td>@v.marca</td>
                <td>@v.modelo</td>
                <td>@v.anio</td>
                <td>@v.kilometraje</td>
                <td>@v.estado</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@v.idVehiculo" class="btn btn-warning btn-sm">
                        Editar
                    </a>
                    <a asp-action="Eliminar" asp-route-id="@v.idVehiculo"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('¿Estás seguro de eliminar este vehículo?');">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

