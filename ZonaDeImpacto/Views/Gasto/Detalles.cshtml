@model ZonaDeImpacto.Models.Gasto
@{
    ViewData["Title"] = "Detalles del Gasto";
}

<div class="card shadow-sm" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header text-white d-flex align-items-center" style="background-color: #17a2b8;">
        <i class="fas fa-money-bill-wave fa-2x me-3"></i>
        <div>
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <small class="opacity-75">Código de Mantenimiento: @Model.codigoMantenimiento</small>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <!-- Información General - 2 columnas de 3 datos -->
            <div class="col-md-6">
                <div class="card border-0 mb-3">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0" style="color: #1a237e;">
                            <i class="fas fa-info-circle me-2"></i>Información del Gasto
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="row">
                            <!-- Columna 1: 3 datos -->
                            <div class="col-12 mb-2">
                                <small class="text-muted">Código de Mantenimiento:</small>
                                <div class="fw-bold">@Model.codigoMantenimiento</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Fecha:</small>
                                <div class="fw-bold">@Model.fecha.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Tipo de Gasto:</small>
                                <div>@Model.tipoGastoNombre</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información Adicional - 2 columnas de 3 datos -->
            <div class="col-md-6">
                <div class="card border-0 mb-3">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0" style="color: #1a237e;">
                            <i class="fas fa-money-bill me-2"></i>Datos del Gasto
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="row">
                            <!-- Columna 2: 3 datos -->
                            <div class="col-12 mb-2">
                                <small class="text-muted">Monto:</small>
                                <div class="fw-bold text-success">S/ @Model.monto.ToString("N2")</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Responsable:</small>
                                <div class="fw-bold">@Model.usuarioNombre</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Estado:</small>
                                <div>
                                    @if (Model.mantenimientoActivo)
                                    {
                                        <span class="badge bg-primary">Mantenimiento Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Mantenimiento Anulado</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Descripción (separada) -->
            <div class="col-12">
                <div class="card border-0">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0" style="color: #1a237e;">
                            <i class="fas fa-file-alt me-2"></i>Descripción
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        @if (!string.IsNullOrEmpty(Model.descripcion))
                        {
                            <div class="border rounded p-3 bg-light">
                                @Model.descripcion
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Sin descripción</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top">
            <div class="d-flex justify-content-center gap-3">
                @if (Model.mantenimientoActivo)
                {
                    <a asp-action="Editar" asp-route-id="@Model.idGasto"
                       class="btn btn-warning px-4">
                        <i class="fas fa-edit me-1"></i> Editar
                    </a>
                }
                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
                @if (ViewBag.Rol == "Admin")
                {
                    <form asp-action="Eliminar" method="post" style="display: inline;">
                        <input type="hidden" name="id" value="@Model.idGasto" />
                        <button type="submit" class="btn btn-danger px-4"
                                onclick="return confirm('¿Estás seguro de eliminar este gasto?');">
                            <i class="fas fa-trash me-1"></i> Eliminar
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 6px;
    }

    .card-header.bg-light {
        background-color: #f8f9fa !important;
    }

    .badge {
        padding: 4px 8px;
        font-size: 12px;
    }

    small.text-muted {
        font-size: 12px;
    }
</style>