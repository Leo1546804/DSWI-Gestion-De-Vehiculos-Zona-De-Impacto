@model IEnumerable<ZonaDeImpacto.Models.Gasto>

@{
    ViewData["Title"] = "Gastos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header text-white" style="background-color: #1a237e;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fas fa-money-bill-wave fa-2x me-3"></i>
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <small class="opacity-75">
                        @if (ViewBag.Rol == "Trabajador")
                        {
                            <span>Mis gastos reportados</span>
                        }
                        else
                        {
                            <span>Control de gastos operativos</span>
                        }
                    </small>
                </div>
            </div>
            @if (ViewBag.Rol != "Trabajador")
            {
                <div>
                    <a asp-action="Crear" class="btn btn-success px-4">
                        <i class="fas fa-money-bill-wave me-1"></i> Nuevo Gasto
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- SECCIÓN DE FILTROS -->
    <div class="card-body border-bottom py-3">
        <form method="get" class="row align-items-end">
            <!-- Campo oculto para mantener la página actual -->
            <input type="hidden" name="pagina" value="1" /> <!-- Siempon en 1 al filtrar -->

            <!-- FILTRO 1: Código Mantenimiento (2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Código Mant.:</label>
                <input type="text" name="filtroMantenimientoCodigo" class="form-control form-control-sm"
                       placeholder="Código" value="@ViewBag.FiltroMantenimientoCodigo" />
            </div>

            <!-- FILTRO 2: Tipo de Gasto (2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Tipo Gasto:</label>
                <select name="filtroTipoGasto" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var tipo in ViewBag.TiposGasto)
                    {
                        <option value="@tipo.idTipoGasto"
                                selected="@(ViewBag.FiltroTipoGasto?.ToString() == tipo.idTipoGasto.ToString())">
                            @tipo.nombre
                        </option>
                    }
                </select>
            </div>

            <!-- FILTRO 3: Responsable (2) -->
            @if (ViewBag.Rol == "Admin")
            {
                <div class="col-md-2 col-lg-2">
                    <label class="form-label mb-1">Responsable:</label>
                    <select name="filtroUsuario" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        @foreach (var usuario in ViewBag.Usuarios)
                        {
                            <option value="@usuario.idUsuario"
                                    selected="@(ViewBag.FiltroUsuario?.ToString() == usuario.idUsuario.ToString())">
                                @usuario.nombreCompleto
                            </option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="col-md-2 col-lg-2">
                    <label class="form-label mb-1">Responsable:</label>
                    <div class="form-control form-control-sm bg-light" style="height: calc(1.5em + 0.5rem + 2px);">
                        <small class="text-muted">
                            <i class="fas fa-user me-1"></i>
                            @if (!string.IsNullOrEmpty(ViewBag.NombreUsuario))
                            {
                                <span>@ViewBag.NombreUsuario</span>
                            }
                            else
                            {
                                <span>Usuario actual</span>
                            }
                        </small>
                        <!-- Campo oculto para mantener el valor del filtro -->
                        <input type="hidden" name="filtroUsuario" value="@ViewBag.IdUsuario" />
                    </div>
                </div>
            }
            <!-- FILTRO 4: Fecha Desde (1) -->
            <div class="col-md-1 col-lg-1">
                <label class="form-label mb-1">Desde:</label>
                <input type="date" name="filtroFechaDesde" class="form-control form-control-sm"
                       value="@ViewBag.FiltroFechaDesde" />
            </div>

            <!-- FILTRO 5: Fecha Hasta (1) -->
            <div class="col-md-1 col-lg-1">
                <label class="form-label mb-1">Hasta:</label>
                <input type="date" name="filtroFechaHasta" class="form-control form-control-sm"
                       value="@ViewBag.FiltroFechaHasta" />
            </div>

            <!-- ESPACIO VACÍO (1) - Para mantener distribución -->
            <div class="col-md-1 col-lg-1">
                <!-- Espacio reservado -->
            </div>

            <!-- BOTÓN LIMPIAR (1) -->
            <div class="col-md-1 col-lg-1">
                @{
                    bool hayFiltros = !string.IsNullOrEmpty(ViewBag.FiltroMantenimientoCodigo?.ToString()) ||
                    !string.IsNullOrEmpty(ViewBag.FiltroTipoGasto?.ToString()) ||
                    !string.IsNullOrEmpty(ViewBag.FiltroUsuario?.ToString()) ||
                    !string.IsNullOrEmpty(ViewBag.FiltroFechaDesde) ||
                    !string.IsNullOrEmpty(ViewBag.FiltroFechaHasta);
                }

                @if (hayFiltros)
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm w-100 py-1">
                        <i class="fas fa-times me-1"></i> Limpiar
                    </a>
                }
                else
                {
                    <div class="w-100" style="height: 33px;"></div>
                }
            </div>

            <!-- BOTÓN FILTRAR (1) -->
            <div class="col-md-1 col-lg-1">
                <button type="submit" class="btn btn-sm w-100 py-1"
                        style="background-color: #283593; border-color: #283593; color: white;">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Código Mant.</th>
                        <th>Tipo de Gasto</th>
                        <th>Monto</th>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Responsable</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var gasto in Model)
                        {
                            <tr>
                                <td>
                                    <div>
                                        <strong>@gasto.codigoMantenimiento</strong>
                                        @if (!gasto.mantenimientoActivo)
                                        {
                                            <div class="text-danger small mt-1" style="font-size: 11px;">
                                                <i class="fas fa-exclamation-circle fa-xs me-1"></i>
                                                Mantenimiento anulado
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td>@gasto.tipoGastoNombre</td>
                                <td class="text-success fw-bold">S/ @gasto.monto.ToString("N2")</td>
                                <td>@gasto.fecha.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(gasto.descripcion))
                                    {
                                        <span class="text-muted" title="@gasto.descripcion">
                                            @(gasto.descripcion.Length > 30 ? gasto.descripcion.Substring(0, 30) + "..." : gasto.descripcion)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Sin descripción</span>
                                    }
                                </td>
                                <td>@gasto.usuarioNombre</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Botón Detalles -->
                                        <a asp-action="Detalles"
                                           asp-route-id="@gasto.idGasto"
                                           asp-route-pagina="@ViewBag.PaginaActual"
                                           asp-route-filtroMantenimientoCodigo="@ViewBag.FiltroMantenimientoCodigo"
                                           asp-route-filtroTipoGasto="@ViewBag.FiltroTipoGasto"
                                           asp-route-filtroUsuario="@ViewBag.FiltroUsuario"
                                           asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                                           asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta"
                                           class="btn btn-info btn-sm" style="min-width: 90px;">
                                            <i class="fas fa-eye me-1"></i> Detalles
                                        </a>

                                        <!-- Botón Editar -->
                                        @if (gasto.mantenimientoActivo)
                                        {
                                            <a asp-action="Editar"
                                               asp-route-id="@gasto.idGasto"
                                               asp-route-pagina="@ViewBag.PaginaActual"
                                               asp-route-filtroMantenimientoCodigo="@ViewBag.FiltroMantenimientoCodigo"
                                               asp-route-filtroTipoGasto="@ViewBag.FiltroTipoGasto"
                                               asp-route-filtroUsuario="@ViewBag.FiltroUsuario"
                                               asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                                               asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta"
                                               class="btn btn-warning btn-sm" style="min-width: 80px;">
                                                <i class="fas fa-edit me-1"></i> Editar
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-warning btn-sm" style="min-width: 80px;" disabled>
                                                <i class="fas fa-edit me-1"></i> Editar
                                            </button>
                                        }

                                        <!-- Botón Eliminar (solo Admin) -->
                                        @if (ViewBag.Rol == "Admin")
                                        {
                                            <form asp-action="Eliminar" method="post" style="display: inline;">
                                                <input type="hidden" name="id" value="@gasto.idGasto" />
                                                <input type="hidden" name="returnUrl" 
                                                       value="@Url.Action("Index", new { 
                                                            pagina = ViewBag.PaginaActual,
                                                            filtroMantenimientoCodigo = ViewBag.FiltroMantenimientoCodigo,
                                                            filtroTipoGasto = ViewBag.FiltroTipoGasto,
                                                            filtroUsuario = ViewBag.FiltroUsuario,
                                                            filtroFechaDesde = ViewBag.FiltroFechaDesde,
                                                            filtroFechaHasta = ViewBag.FiltroFechaHasta
                                                       })" />
                                                <button type="submit" class="btn btn-danger btn-sm"
                                                        style="min-width: 90px;"
                                                        onclick="return confirm('¿Estás seguro de eliminar este gasto?');">
                                                    <i class="fas fa-trash me-1"></i> Eliminar
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-money-bill-wave fa-2x text-muted mb-2"></i>
                                @{
                                    bool filtrosActivos = !string.IsNullOrEmpty(ViewBag.FiltroMantenimientoCodigo) ||
                                    (ViewBag.FiltroTipoGasto != null && ViewBag.FiltroTipoGasto > 0) ||
                                    (ViewBag.FiltroUsuario != null && ViewBag.FiltroUsuario > 0) ||
                                    !string.IsNullOrEmpty(ViewBag.FiltroFechaDesde) ||
                                    !string.IsNullOrEmpty(ViewBag.FiltroFechaHasta);
                                }
                                
                                @if (filtrosActivos)
                                {
                                    <p class="text-muted mb-0">
                                        No hay gastos que coincidan con los filtros aplicados
                                    </p>
                                    <div class="mt-2">
                                        @if (ViewBag.FiltroUsuario != null && ViewBag.Usuarios != null)
                                        {
                                            var usuarioSeleccionado = ((IEnumerable<dynamic>)ViewBag.Usuarios)?
                                                .FirstOrDefault(u => u.idUsuario == ViewBag.FiltroUsuario);
                                            if (usuarioSeleccionado != null)
                                            {
                                                <small class="text-info">
                                                    <i class="fas fa-user me-1"></i> 
                                                    Responsable: @usuarioSeleccionado.nombreCompleto
                                                </small>
                                                <br />
                                            }
                                        }
                                        @if (!string.IsNullOrEmpty(ViewBag.FiltroMantenimientoCodigo))
                                        {
                                            <small class="text-info">
                                                <i class="fas fa-barcode me-1"></i> 
                                                Código: @ViewBag.FiltroMantenimientoCodigo
                                            </small>
                                            <br />
                                        }
                                        @if (ViewBag.FiltroTipoGasto != null && ViewBag.TiposGasto != null)
                                        {
                                            var tipoSeleccionado = ((IEnumerable<dynamic>)ViewBag.TiposGasto)?
                                                .FirstOrDefault(t => t.idTipoGasto == ViewBag.FiltroTipoGasto);
                                            if (tipoSeleccionado != null)
                                            {
                                                <small class="text-info">
                                                    <i class="fas fa-tag me-1"></i> 
                                                    Tipo: @tipoSeleccionado.nombre
                                                </small>
                                                <br />
                                            }
                                        }
                                        @if (!string.IsNullOrEmpty(ViewBag.FiltroFechaDesde) || !string.IsNullOrEmpty(ViewBag.FiltroFechaHasta))
                                        {
                                            <small class="text-info">
                                                <i class="fas fa-calendar me-1"></i> 
                                                Rango de fechas: 
                                                @if (!string.IsNullOrEmpty(ViewBag.FiltroFechaDesde))
                                                {
                                                    <span>Desde @ViewBag.FiltroFechaDesde</span>
                                                }
                                                @if (!string.IsNullOrEmpty(ViewBag.FiltroFechaHasta))
                                                {
                                                    <span>Hasta @ViewBag.FiltroFechaHasta</span>
                                                }
                                            </small>
                                        }
                                    </div>
                                    <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-sm mt-3">
                                        <i class="fas fa-times me-1"></i> Limpiar filtros
                                    </a>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No hay gastos registrados</p>
                                    @if (ViewBag.Rol != "Trabajador")
                                    {
                                        <a asp-action="Crear" class="btn btn-success btn-sm mt-2">
                                            <i class="fas fa-money-bill-wave me-1"></i> Registrar Primer Gasto
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Paginación - SOLO MOSTRAR SI HAY RESULTADOS Y MÁS DE 1 PÁGINA -->
            @if (Model != null && Model.Any() && ViewBag.TotalPaginas > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <!-- Botón Anterior -->
                        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                               asp-route-filtroMantenimientoCodigo="@ViewBag.FiltroMantenimientoCodigo"
                               asp-route-filtroTipoGasto="@ViewBag.FiltroTipoGasto"
                               asp-route-filtroUsuario="@ViewBag.FiltroUsuario"
                               asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                               asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta">
                                <i class="fas fa-chevron-left"></i> Anterior
                            </a>
                        </li>

                        <!-- Página 1 -->
                        @if (ViewBag.PaginaActual > 3)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pagina="1"
                                   asp-route-filtroMantenimientoCodigo="@ViewBag.FiltroMantenimientoCodigo"
                                   asp-route-filtroTipoGasto="@ViewBag.FiltroTipoGasto"
                                   asp-route-filtroUsuario="@ViewBag.FiltroUsuario"
                                   asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                                   asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta">
                                    1
                                </a>
                            </li>
                            @if (ViewBag.PaginaActual > 4)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        <!-- Páginas alrededor de la actual -->
                        @for (int i = Math.Max(1, ViewBag.PaginaActual - 2); i <= Math.Min(ViewBag.TotalPaginas, ViewBag.PaginaActual + 2); i++)
                        {
                            <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pagina="@i"
                                   asp-route-filtroMantenimientoCodigo="@ViewBag.FiltroMantenimientoCodigo"
                                   asp-route-filtroTipoGasto="@ViewBag.FiltroTipoGasto"
                                   asp-route-filtroUsuario="@ViewBag.FiltroUsuario"
                                   asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                                   asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Última página -->
                        @if (ViewBag.PaginaActual < ViewBag.TotalPaginas - 2)
                        {
                            @if (ViewBag.PaginaActual < ViewBag.TotalPaginas - 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pagina="@ViewBag.TotalPaginas"
                                   asp-route-filtroMantenimientoCodigo="@ViewBag.FiltroMantenimientoCodigo"
                                   asp-route-filtroTipoGasto="@ViewBag.FiltroTipoGasto"
                                   asp-route-filtroUsuario="@ViewBag.FiltroUsuario"
                                   asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                                   asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta">
                                    @ViewBag.TotalPaginas
                                </a>
                            </li>
                        }

                        <!-- Botón Siguiente -->
                        <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                               asp-route-filtroMantenimientoCodigo="@ViewBag.FiltroMantenimientoCodigo"
                               asp-route-filtroTipoGasto="@ViewBag.FiltroTipoGasto"
                               asp-route-filtroUsuario="@ViewBag.FiltroUsuario"
                               asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                               asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta">
                                Siguiente <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }

            <!-- Mostrar información de paginación - SOLO SI HAY RESULTADOS -->
            @if (Model != null && Model.Any() && ViewBag.TotalRegistros > 0)
            {
                <div class="text-center text-muted mt-2">
                    <small>
                        Mostrando @(((ViewBag.PaginaActual - 1) * 6 + 1)) a
                        @Math.Min(ViewBag.PaginaActual * 6, ViewBag.TotalRegistros)
                        de @ViewBag.TotalRegistros gastos
                    </small>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 8px;
        background-color: #1a237e;
        color: white;
    }

    .table td {
        font-size: 14px;
        padding: 12px 8px;
        vertical-align: middle;
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 13px;
    }

    .d-flex.gap-2 {
        gap: 10px !important;
    }

    .badge {
        font-size: 12px;
        padding: 4px 8px;
    }

    .form-label {
        font-weight: 500;
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
        color: #495057;
    }

    .form-control-sm, .form-select-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        height: calc(1.5em + 0.5rem + 2px);
    }

    .pagination {
        margin-top: 20px;
        margin-bottom: 0;
    }

    .page-link {
        color: #1a237e;
        border-color: #1a237e;
    }

    .page-item.active .page-link {
        background-color: #1a237e;
        border-color: #1a237e;
        color: white;
    }

    .page-link:hover {
        color: #1a237e;
        background-color: #e8eaf6;
    }

    .page-item.disabled .page-link {
        color: #6c757d;
        background-color: #fff;
        border-color: #dee2e6;
    }
</style>