@model ZonaDeImpacto.Models.Gasto
@{
    ViewData["Title"] = "Editar Gasto";
}

<div class="card shadow-sm" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header text-white" style="background-color: #d4a017;">
        <h5 class="mb-0">
            <i class="fas fa-edit me-2"></i>@ViewData["Title"]
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="idGasto" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Mantenimiento: <strong>@Model.codigoMantenimiento</strong> |
                Responsable: <strong>@Model.usuarioNombre</strong>
            </div>

            <div class="row">
                <!-- Columna Izquierda -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label">Mantenimiento</label>
                        <div class="form-control bg-light">
                            <strong>@Model.codigoMantenimiento</strong>
                            @if (!Model.mantenimientoActivo)
                            {
                                <span class="badge bg-danger ms-2">Anulado</span>
                            }
                        </div>
                        <small class="form-text text-muted">El mantenimiento no puede cambiarse</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="idTipoGasto" class="form-label">Tipo de Gasto *</label>
                        <select asp-for="idTipoGasto" class="form-select" required>
                            <option value="">Seleccione un tipo</option>
                            @foreach (var tipo in ViewBag.TiposGasto)
                            {
                                <option value="@tipo.idTipoGasto" selected="@(tipo.idTipoGasto == Model.idTipoGasto)">
                                    @tipo.nombre
                                </option>
                            }
                        </select>
                        <span asp-validation-for="idTipoGasto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="monto" class="form-label">Monto *</label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input asp-for="monto" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>
                        <span asp-validation-for="monto" class="text-danger"></span>
                    </div>
                </div>

                <!-- Columna Derecha -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="fecha" class="form-label">Fecha *</label>
                        <input asp-for="fecha" type="date" class="form-control" required
                               value="@Model.fecha.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="fecha" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="descripcion" class="form-control" rows="4"
                                  placeholder="Describa el gasto realizado...">@Model.descripcion</textarea>
                        <span asp-validation-for="descripcion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @if (!Model.mantenimientoActivo)
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Advertencia:</strong> Este gasto pertenece a un mantenimiento anulado.
                    Los cambios pueden no reflejarse correctamente.
                </div>
            }

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-warning px-4" style="background-color: #d4a017; border-color: #d4a017;">
                        <i class="fas fa-save me-1"></i> Actualizar
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
                    {
                        <a href="@ViewBag.ReturnUrl" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-1"></i> Cancelar
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left me-1"></i> Volver
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
