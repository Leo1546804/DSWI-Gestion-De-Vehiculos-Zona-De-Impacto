@model ZonaDeImpacto.Models.Mantenimiento
@{
    ViewData["Title"] = "Registrar Mantenimiento";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header text-white" style="background-color: #1a237e;">
        <h5 class="mb-0">
            <i class="fas fa-plus-circle me-2"></i>@ViewData["Title"]
        </h5>
    </div>

    <div class="card-body">
        <!-- Mostrar errores de validación -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <h6><i class="fas fa-exclamation-triangle me-2"></i>Errores en el formulario:</h6>
                <ul class="mb-0">
                    @foreach (var key in ViewData.ModelState.Keys)
                    {
                        foreach (var error in ViewData.ModelState[key].Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
        }

        <form asp-action="Crear" method="post">
            <!-- NO DEBE HABER CAMPO PARA codigoMantenimiento -->

            <div class="row">
                <!-- Columna Izquierda -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="idVehiculo" class="form-label">Vehículo *</label>
                        <select asp-for="idVehiculo" class="form-select" required>
                            <option value="">Seleccione un vehículo</option>
                            @foreach (var vehiculo in ViewBag.Vehiculos)
                            {
                                <option value="@vehiculo.idVehiculo">@vehiculo.placa - @vehiculo.marca @vehiculo.modelo</option>
                            }
                        </select>
                        <span asp-validation-for="idVehiculo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="tipo" class="form-label">Tipo *</label>
                        <select asp-for="tipo" class="form-select" required>
                            <option value="">Seleccione un tipo</option>
                            @foreach (var tipo in ViewBag.Tipos)
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                        <span asp-validation-for="tipo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="fecha" class="form-label">Fecha *</label>
                        <input asp-for="fecha" type="date" class="form-control" required />
                        <span asp-validation-for="fecha" class="text-danger"></span>
                        <small class="form-text text-muted">Ejemplo: 15/01/2024</small>
                    </div>
                </div>

                <!-- Columna Derecha -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="descripcion" class="form-control" rows="5"
                                  placeholder="Describa el mantenimiento realizado..."></textarea>
                        <span asp-validation-for="descripcion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="idUsuario" class="form-label">Responsable *</label>
                        <select asp-for="idUsuario" class="form-select" required>
                            <option value="">Seleccione un responsable</option>
                            @foreach (var usuario in ViewBag.Usuarios)
                            {
                                <option value="@usuario.idUsuario">@usuario.nombreCompleto (@usuario.rol)</option>
                            }
                        </select>
                        <span asp-validation-for="idUsuario" class="text-danger"></span>
                        <small class="form-text text-muted">Seleccione el usuario responsable</small>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-1"></i> Registrar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}