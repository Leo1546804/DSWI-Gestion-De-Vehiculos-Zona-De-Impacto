@model ZonaDeImpacto.Models.Mantenimiento
@{
    ViewData["Title"] = "Detalles del Mantenimiento";
}

<div class="card shadow-sm" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header text-white d-flex align-items-center" style="background-color: #17a2b8;">
        <i class="fas fa-tools fa-2x me-3"></i>
        <div>
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <small class="opacity-75">Código: @Model.codigoMantenimiento</small>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <!-- Información General -->
            <div class="col-md-6">
                <div class="card border-0 mb-3">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0" style="color: #1a237e;">
                            <i class="fas fa-info-circle me-2"></i>Información General
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-12 mb-2">
                                <small class="text-muted">Código:</small>
                                <div class="fw-bold">@Model.codigoMantenimiento</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Fecha:</small>
                                <div class="fw-bold">@Model.fecha.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Tipo:</small>
                                <div>
                                    <span class="badge @(Model.tipo == "Preventivo" ? "bg-success" : "bg-warning")">
                                        @Model.tipo
                                    </span>
                                </div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Estado:</small>
                                <div>
                                    @if (Model.estadoLogico)
                                    {
                                        <span class="badge bg-primary">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Anulado</span>
                                    }
                                </div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Responsable:</small>
                                <div class="fw-bold">@Model.usuarioNombre</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información del Vehículo -->
            <div class="col-md-6">
                <div class="card border-0 mb-3">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0" style="color: #1a237e;">
                            <i class="fas fa-car me-2"></i>Vehículo
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-6 mb-2">
                                <small class="text-muted">Placa:</small>
                                <div class="fw-bold">@Model.placa</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Marca:</small>
                                <div>@Model.marca</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Modelo:</small>
                                <div>@Model.modelo</div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Tipo:</small>
                                <div>@(Model.tipoVehiculo ?? "N/A")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Descripción -->
            <div class="col-12">
                <div class="card border-0">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0" style="color: #1a237e;">
                            <i class="fas fa-file-alt me-2"></i>Descripción
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        @if (!string.IsNullOrEmpty(Model.descripcion))
                        {
                            <div class="border rounded p-3 bg-light">
                                @Model.descripcion
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Sin descripción</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top">
            <div class="d-flex justify-content-center gap-3">
                @if (Model.estadoLogico)
                {
                    <a asp-action="Editar" asp-route-id="@Model.idMantenimiento"
                       class="btn btn-warning px-4">
                        <i class="fas fa-edit me-1"></i> Editar
                    </a>
                }
                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 6px;
    }

    .card-header.bg-light {
        background-color: #f8f9fa !important;
    }

    .badge {
        padding: 4px 8px;
        font-size: 12px;
    }

    small.text-muted {
        font-size: 12px;
    }
</style>