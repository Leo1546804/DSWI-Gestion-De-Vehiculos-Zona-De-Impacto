@model ZonaDeImpacto.Models.Mantenimiento
@{
    ViewData["Title"] = "Editar Mantenimiento";
    var rol = ViewBag.Rol as string;
    var esAdmin = rol == "Admin";
}

<div class="card shadow-sm" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header text-white" style="background-color: #d4a017;">
        <h5 class="mb-0">
            <i class="fas fa-edit me-2"></i>@ViewData["Title"]
        </h5>
    </div>

    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="idMantenimiento" />
            <input type="hidden" asp-for="codigoMantenimiento" />
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Mantenimiento: <strong>@Model.codigoMantenimiento</strong>
            </div>

            <div class="row">
                <!-- Columna Izquierda -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="idVehiculo" class="form-label">Vehículo *</label>
                        <select asp-for="idVehiculo" class="form-select" required>
                            <option value="">Seleccione un vehículo</option>
                            @foreach (var vehiculo in ViewBag.Vehiculos)
                            {
                                <option value="@vehiculo.idVehiculo"
                                        selected="@(vehiculo.idVehiculo == Model.idVehiculo)">
                                    @vehiculo.placa - @vehiculo.marca @vehiculo.modelo
                                </option>
                            }
                        </select>
                        <span asp-validation-for="idVehiculo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="tipo" class="form-label">Tipo *</label>
                        <select asp-for="tipo" class="form-select" required>
                            <option value="">Seleccione un tipo</option>
                            @foreach (var tipo in ViewBag.Tipos)
                            {
                                <option value="@tipo" selected="@(tipo == Model.tipo)">
                                    @tipo
                                </option>
                            }
                        </select>
                        <span asp-validation-for="tipo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="fecha" class="form-label">Fecha *</label>
                        <input asp-for="fecha" type="date" class="form-control"
                               value="@Model.fecha.ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="fecha" class="text-danger"></span>
                        <small class="form-text text-muted">Formato: DD/MM/AAAA</small>
                    </div>
                </div>

                <!-- Columna Derecha -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="descripcion" class="form-control" rows="5"
                                  placeholder="Describa el mantenimiento realizado...">@Model.descripcion</textarea>
                        <span asp-validation-for="descripcion" class="text-danger"></span>
                    </div>

                    <!-- Campo Responsable -->
                    <div class="mb-3">
                        <label class="form-label">Responsable *</label>
                        @if (esAdmin)
                        {
                            <select asp-for="idUsuario" class="form-select" required>
                                <option value="">Seleccione un responsable</option>
                                @foreach (var usuario in ViewBag.Usuarios)
                                {
                                    <option value="@usuario.idUsuario"
                                            selected="@(usuario.idUsuario == Model.idUsuario)">
                                        @usuario.nombreCompleto (@usuario.rol)
                                    </option>
                                }
                            </select>
                            <small class="form-text text-muted">
                                <i class="fas fa-info-circle"></i>
                                Como Administrador, puede cambiar el responsable.
                            </small>
                        }
                        else
                        {
                            <!-- Para trabajador: mostrar nombre y pasar ID como oculto -->
                            <input type="hidden" asp-for="idUsuario" value="@Model.idUsuario" />
                            <div class="form-control" style="background-color: #f8f9fa; height: 38px; line-height: 24px;">
                                <i class="fas fa-user me-2"></i>
                                @Model.usuarioNombre
                            </div>
                            <small class="form-text text-muted">
                                <i class="fas fa-user me-1"></i>
                                Usted es el responsable de este mantenimiento.
                            </small>
                        }
                        <span asp-validation-for="idUsuario" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-warning px-4" style="background-color: #d4a017; border-color: #d4a017;">
                        <i class="fas fa-save me-1"></i> Actualizar
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
                    {
                        <a href="@ViewBag.ReturnUrl" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-1"></i> Cancelar
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left me-1"></i> Volver
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}