@model IEnumerable<ZonaDeImpacto.Models.Mantenimiento>

@{
    ViewData["Title"] = "Mantenimientos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header text-white" style="background-color: #1a237e;">
        <div class="d-flex align-items-center">
            <div class="flex-grow-1">
                <h5 class="mb-0">
                    <i class="fas fa-tools me-2"></i>@ViewData["Title"]
                </h5>
            </div>

            <div class="me-4">
                <a asp-action="Crear" class="btn btn-success px-4">
                    <i class="fas fa-plus-circle me-1"></i> Agregar Mantenimiento
                </a>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr class="table-primary">
                        <th>Vehículo</th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Costo</th>
                        <th>Fecha</th>
                        <th>Registrado por</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mantenimiento in Model)
                    {
                        <tr>
                            <td>
                                <div>
                                    <strong>@mantenimiento.placa</strong><br>
                                    <small class="text-muted">@mantenimiento.marca @mantenimiento.modelo</small>
                                </div>
                            </td>
                            <td>
                                @if (mantenimiento.tipo == "Preventivo")
                                {
                                    <span class="badge bg-info">@mantenimiento.tipo</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@mantenimiento.tipo</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(mantenimiento.descripcion))
                                {
                                    <span class="text-muted">@mantenimiento.descripcion</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Sin descripción</span>
                                }
                            </td>
                            <td>
                                <strong class="text-success">S/. @mantenimiento.costo.ToString("N2")</strong>
                            </td>
                            <td>@mantenimiento.fecha.ToString("dd/MM/yyyy")</td>
                            <td>@mantenimiento.usuarioNombre</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- Botón Detalles (NUEVO) -->
                                    <a asp-action="Detalles" asp-route-id="@mantenimiento.idMantenimiento" class="btn btn-info btn-sm" style="min-width: 90px;">
                                        <i class="fas fa-eye me-1"></i> Detalles
                                    </a>

                                    <!-- Botón Editar -->
                                    <a asp-action="Editar" asp-route-id="@mantenimiento.idMantenimiento" class="btn btn-warning btn-sm" style="min-width: 80px;">
                                        <i class="fas fa-edit me-1"></i> Editar
                                    </a>

                                    <!-- Botón Eliminar -->
                                    <a asp-action="Eliminar" asp-route-id="@mantenimiento.idMantenimiento" class="btn btn-danger btn-sm" style="min-width: 80px;"
                                       onclick="return confirm('¿ESTÁS SEGURO? Esta acción eliminará permanentemente el mantenimiento.');">
                                        <i class="fas fa-trash-alt me-1"></i> Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-info-circle fa-lg text-muted mb-2"></i>
                                <p class="text-muted mb-0">No hay mantenimientos registrados</p>
                                <a asp-action="Crear" class="btn btn-success mt-2">
                                    <i class="fas fa-plus-circle me-1"></i> Agregar el Primer Mantenimiento
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table th {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 8px;
        background-color: #1a237e;
        color: white;
    }

    .table td {
        font-size: 14px;
        padding: 12px 8px;
        vertical-align: middle;
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 13px;
    }

    .d-flex.gap-2 {
        gap: 10px !important;
    }

    .card {
        border-radius: 8px;
    }

    .badge {
        font-size: 12px;
        padding: 4px 8px;
    }
</style>