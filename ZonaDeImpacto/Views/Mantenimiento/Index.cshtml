@model IEnumerable<ZonaDeImpacto.Models.Mantenimiento>

@{
    ViewData["Title"] = "Mantenimientos";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header text-white" style="background-color: #1a237e;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fas fa-wrench fa-2x me-3"></i>
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <small class="opacity-75">
                        @if (ViewBag.Rol == "Trabajador")
                        {
                            <span>Mis mantenimientos realizados</span>
                        }
                        else
                        {
                            <span>Gestión de mantenimientos vehiculares</span>
                        }
                    </small>
                </div>
            </div>
            @if (ViewBag.Rol != "Trabajador")
            {
                <div>
                    <a asp-action="Crear" class="btn btn-success px-4">
                        <i class="fas fa-plus me-1"></i> Nuevo Mantenimiento
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- SECCIÓN DE FILTROS -->
    <div class="card-body border-bottom py-3">
        <form method="get" class="row align-items-end">
            <!-- Campo oculto para mantener la página actual -->
            <input type="hidden" name="pagina" value="@ViewBag.PaginaActual" />

            <!-- FILTRO 1: Código (2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Código:</label>
                <input type="text" name="filtroCodigo" class="form-control form-control-sm"
                       placeholder="Código" value="@ViewBag.FiltroCodigo" />
            </div>

            <!-- FILTRO 2: Vehículo (2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Vehículo:</label>
                <select name="filtroVehiculo" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var vehiculo in ViewBag.Vehiculos)
                    {
                        <option value="@vehiculo.idVehiculo"
                                selected="@(ViewBag.FiltroVehiculo?.ToString() == vehiculo.idVehiculo.ToString())">
                            @vehiculo.placa
                        </option>
                    }
                </select>
            </div>

            <!-- FILTRO 3: Tipo (2) -->
            <div class="col-md-2 col-lg-2">
                <label class="form-label mb-1">Tipo:</label>
                <select name="filtroTipo" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var tipo in ViewBag.Tipos)
                    {
                        <option value="@tipo"
                                selected="@(ViewBag.FiltroTipo == tipo)">
                            @tipo
                        </option>
                    }
                </select>
            </div>

            <!-- FILTRO 4: Fecha Desde (1) -->
            <div class="col-md-1 col-lg-1">
                <label class="form-label mb-1">Desde:</label>
                <input type="date" name="filtroFechaDesde" class="form-control form-control-sm"
                       value="@ViewBag.FiltroFechaDesde" />
            </div>

            <!-- FILTRO 5: Fecha Hasta (1) -->
            <div class="col-md-1 col-lg-1">
                <label class="form-label mb-1">Hasta:</label>
                <input type="date" name="filtroFechaHasta" class="form-control form-control-sm"
                       value="@ViewBag.FiltroFechaHasta" />
            </div>

            <!-- FILTRO 6: Estado (1) -->
            <div class="col-md-1 col-lg-1">
                <label class="form-label mb-1">Estado:</label>
                <select name="filtroEstado" class="form-select form-select-sm">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.FiltroEstado))">Todos</option>
                    <option value="activos" selected="@(ViewBag.FiltroEstado == "activos")">Activos</option>
                    <option value="anulados" selected="@(ViewBag.FiltroEstado == "anulados")">Anulados</option>
                </select>
            </div>

            <!-- BOTÓN LIMPIAR (1) -->
            <div class="col-md-1 col-lg-1">
                @if (!string.IsNullOrEmpty(ViewBag.FiltroCodigo?.ToString()) ||
                                !string.IsNullOrEmpty(ViewBag.FiltroVehiculo?.ToString()) ||
                                !string.IsNullOrEmpty(ViewBag.FiltroTipo) ||
                                !string.IsNullOrEmpty(ViewBag.FiltroFechaDesde) ||
                                !string.IsNullOrEmpty(ViewBag.FiltroFechaHasta) ||
                                !string.IsNullOrEmpty(ViewBag.FiltroEstado) ||
                                (ViewBag.PaginaActual > 1))
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm w-100 py-1">
                        <i class="fas fa-times me-1"></i> Limpiar
                    </a>
                }
                else
                {
                    <div class="w-100" style="height: 33px;"></div>
                }
            </div>

            <!-- BOTÓN FILTRAR (1) -->
            <div class="col-md-1 col-lg-1">
                <button type="submit" class="btn btn-sm w-100 py-1"
                        style="background-color: #283593; border-color: #283593; color: white;">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Vehículo</th>
                        <th>Tipo</th>
                        <th>Descripción</th>
                        <th>Fecha</th>
                        <th>Responsable</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var mantenimiento in Model)
                        {
                            <tr>
                                <td><strong>@mantenimiento.codigoMantenimiento</strong></td>
                                <td>
                                    <div class="fw-medium">@mantenimiento.placa</div>
                                    <small class="text-muted">@mantenimiento.marca @mantenimiento.modelo</small>
                                </td>
                                <td>@mantenimiento.tipo</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(mantenimiento.descripcion))
                                    {
                                        <span class="text-muted" title="@mantenimiento.descripcion">
                                            @(mantenimiento.descripcion.Length > 30 ? mantenimiento.descripcion.Substring(0, 30) + "..." : mantenimiento.descripcion)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Sin descripción</span>
                                    }
                                </td>
                                <td>@mantenimiento.fecha.ToString("dd/MM/yyyy")</td>
                                <td>@mantenimiento.usuarioNombre</td>
                                <td>
                                    @if (mantenimiento.estadoLogico)
                                    {
                                        <span class="badge bg-primary">
                                            <i class="fas fa-check me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-times me-1"></i> Anulado
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Botón Detalles -->
                                        <a asp-action="Detalles" asp-route-id="@mantenimiento.idMantenimiento"
                                           class="btn btn-info btn-sm" style="min-width: 90px;">
                                            <i class="fas fa-eye me-1"></i> Detalles
                                        </a>

                                        <!-- Botón Editar -->
                                        @if (mantenimiento.estadoLogico)
                                        {
                                            <a asp-action="Editar" asp-route-id="@mantenimiento.idMantenimiento"
                                               class="btn btn-warning btn-sm" style="min-width: 80px;">
                                                <i class="fas fa-edit me-1"></i> Editar
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-warning btn-sm" style="min-width: 80px;" disabled>
                                                <i class="fas fa-edit me-1"></i> Editar
                                            </button>
                                        }

                                        <!-- Botón Anular/Habilitar (solo Admin) -->
                                        @if (ViewBag.Rol == "Admin")
                                        {
                                            @if (mantenimiento.estadoLogico)
                                            {
                                                <form asp-action="Eliminar" method="post" style="display: inline;">
                                                    <input type="hidden" name="id" value="@mantenimiento.idMantenimiento" />
                                                    <input type="hidden" name="returnUrl" 
                                                           value="@Url.Action("Index", new { 
                                                                pagina = ViewBag.PaginaActual,
                                                                filtroCodigo = ViewBag.FiltroCodigo,
                                                                filtroVehiculo = ViewBag.FiltroVehiculo,
                                                                filtroTipo = ViewBag.FiltroTipo,
                                                                filtroFechaDesde = ViewBag.FiltroFechaDesde,
                                                                filtroFechaHasta = ViewBag.FiltroFechaHasta,
                                                                filtroEstado = ViewBag.FiltroEstado
                                                           })" />
                                                    <button type="submit" class="btn btn-danger btn-sm"
                                                            style="min-width: 110px;"
                                                            onclick="return confirm('¿Estás seguro de anular el mantenimiento @mantenimiento.codigoMantenimiento?');">
                                                        <i class="fas fa-ban me-1"></i> Anular
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Habilitar" method="post" style="display: inline;">
                                                    <input type="hidden" name="id" value="@mantenimiento.idMantenimiento" />
                                                    <input type="hidden" name="returnUrl" 
                                                           value="@Url.Action("Index", new { 
                                                                pagina = ViewBag.PaginaActual,
                                                                filtroCodigo = ViewBag.FiltroCodigo,
                                                                filtroVehiculo = ViewBag.FiltroVehiculo,
                                                                filtroTipo = ViewBag.FiltroTipo,
                                                                filtroFechaDesde = ViewBag.FiltroFechaDesde,
                                                                filtroFechaHasta = ViewBag.FiltroFechaHasta,
                                                                filtroEstado = ViewBag.FiltroEstado
                                                           })" />
                                                    <button type="submit" class="btn btn-success btn-sm"
                                                            style="min-width: 110px;"
                                                            onclick="return confirm('¿Estás seguro de habilitar el mantenimiento @mantenimiento.codigoMantenimiento?');">
                                                        <i class="fas fa-check-circle me-1"></i> Habilitar
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <i class="fas fa-wrench fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">
                                    @if (!string.IsNullOrEmpty(ViewBag.FiltroCodigo?.ToString()) ||
                                                                    !string.IsNullOrEmpty(ViewBag.FiltroVehiculo?.ToString()) ||
                                                                    !string.IsNullOrEmpty(ViewBag.FiltroTipo) ||
                                                                    !string.IsNullOrEmpty(ViewBag.FiltroFechaDesde) ||
                                                                    !string.IsNullOrEmpty(ViewBag.FiltroFechaHasta) ||
                                                                    !string.IsNullOrEmpty(ViewBag.FiltroEstado))
                                    {
                                        <span>No hay mantenimientos que coincidan con los filtros aplicados</span>
                                    }
                                    else
                                    {
                                        <span>No hay mantenimientos registrados</span>
                                    }
                                </p>
                                @if (!string.IsNullOrEmpty(ViewBag.FiltroCodigo?.ToString()) ||
                                                            !string.IsNullOrEmpty(ViewBag.FiltroVehiculo?.ToString()) ||
                                                            !string.IsNullOrEmpty(ViewBag.FiltroTipo) ||
                                                            !string.IsNullOrEmpty(ViewBag.FiltroFechaDesde) ||
                                                            !string.IsNullOrEmpty(ViewBag.FiltroFechaHasta) ||
                                                            !string.IsNullOrEmpty(ViewBag.FiltroEstado))
                                {
                                    <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-sm mt-2">
                                        <i class="fas fa-times me-1"></i> Limpiar filtros
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Crear" class="btn btn-success btn-sm mt-2">
                                        <i class="fas fa-plus me-1"></i> Registrar Primer Mantenimiento
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Paginación -->
            @if (ViewBag.TotalPaginas > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                               asp-route-filtroCodigo="@ViewBag.FiltroCodigo"
                               asp-route-filtroVehiculo="@ViewBag.FiltroVehiculo"
                               asp-route-filtroTipo="@ViewBag.FiltroTipo"
                               asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                               asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta"
                               asp-route-filtroEstado="@ViewBag.FiltroEstado">
                                Anterior
                            </a>
                        </li>
                        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pagina="@i"
                                   asp-route-filtroCodigo="@ViewBag.FiltroCodigo"
                                   asp-route-filtroVehiculo="@ViewBag.FiltroVehiculo"
                                   asp-route-filtroTipo="@ViewBag.FiltroTipo"
                                   asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                                   asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta"
                                   asp-route-filtroEstado="@ViewBag.FiltroEstado">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                               asp-route-filtroCodigo="@ViewBag.FiltroCodigo"
                               asp-route-filtroVehiculo="@ViewBag.FiltroVehiculo"
                               asp-route-filtroTipo="@ViewBag.FiltroTipo"
                               asp-route-filtroFechaDesde="@ViewBag.FiltroFechaDesde"
                               asp-route-filtroFechaHasta="@ViewBag.FiltroFechaHasta"
                               asp-route-filtroEstado="@ViewBag.FiltroEstado">
                                Siguiente
                            </a>
                        </li>
                    </ul>
                </nav>
            }
            <!-- Mostrar información de paginación -->
            @if (ViewBag.TotalRegistros > 0)
            {
                <div class="text-center text-muted mt-2">
                    <small>
                        Mostrando @(((ViewBag.PaginaActual - 1) * 6 + 1)) a
                        @Math.Min(ViewBag.PaginaActual * 6, ViewBag.TotalRegistros)
                        de @ViewBag.TotalRegistros mantenimientos
                    </small>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th {
        font-size: 14px;
        font-weight: 600;
        padding: 12px 8px;
        background-color: #1a237e;
        color: white;
    }

    .table td {
        font-size: 14px;
        padding: 12px 8px;
        vertical-align: middle;
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 13px;
    }

    .d-flex.gap-2 {
        gap: 10px !important;
    }

    .badge {
        font-size: 12px;
        padding: 4px 8px;
    }

    .form-label {
        font-weight: 500;
        font-size: 0.85rem;
        margin-bottom: 0.25rem;
        color: #495057;
    }

    .form-control-sm, .form-select-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        height: calc(1.5em + 0.5rem + 2px);
    }

    .pagination {
        margin-top: 20px;
        margin-bottom: 0;
    }

    .page-link {
        color: #1a237e;
        border-color: #1a237e;
    }

    .page-item.active .page-link {
        background-color: #1a237e;
        border-color: #1a237e;
    }

    .page-link:hover {
        color: #1a237e;
        background-color: #e8eaf6;
    }
</style>